{
  "name": "telegram-lite-desktop",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:desktop\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/server && npm run build -w apps/desktop",
    "build:web": "npm run build -w apps/web",
    "build:all": "npm run build -w apps/server && npm run build -w apps/desktop && npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
